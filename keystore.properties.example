# Release signing credentials for CoinTrail.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in your own values.
# If `keystore.properties` is absent the release build is left unsigned, so a fresh clone still
# builds — but a signed APK/AAB always needs it.
#
# Create the keystore once (keep the .jks and its passwords safe and backed up — losing the upload
# key means you cannot ship updates for an app already on Google Play):
#
#   keytool -genkeypair -v \
#     -keystore cointrail-release.jks \
#     -alias cointrail \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# `storeFile` is resolved relative to the repository root.

storeFile=cointrail-release.jks
storePassword=change-me
keyAlias=cointrail
keyPassword=change-me
